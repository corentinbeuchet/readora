{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "readora-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/readora-frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles"
              ]
            },
            "scripts": [],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "i18nMissingTranslation": "error"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "localize": true
            },
            "staging": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.staging.ts"
                }
              ],
              "outputHashing": "all",
              "localize": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "fr": {
              "localize": [
                "fr"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "readora-frontend:build:production"
            },
            "staging": {
              "buildTarget": "readora-frontend:build:staging"
            },
            "development": {
              "buildTarget": "readora-frontend:build:development"
            },
            "fr": {
              "buildTarget": "readora-frontend:build:development,fr",
              "prebundle": false
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "runnerConfig": "vitest-base.config.ts",
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": "readora-frontend:build:development",
            "include": [
              "../tests/unit/**/*.spec.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              "tests/**/*.ts"
            ]
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "readora-frontend:build:development",
            "format": "json",
            "outputPath": "src/locale"
          }
        }
      },
      "i18n": {
        "sourceLocale": {
          "code": "en",
          "subPath": ""
        },
        "locales": {
          "fr": {
            "translation": [
              "src/locale/fr/auth.json",
              "src/locale/fr/catalog.json",
              "src/locale/fr/common.json",
              "src/locale/fr/community.json",
              "src/locale/fr/discovery.json",
              "src/locale/fr/errors.json",
              "src/locale/fr/labels.json",
              "src/locale/fr/layout.json",
              "src/locale/fr/library.json",
              "src/locale/fr/lists.json",
              "src/locale/fr/moderation.json",
              "src/locale/fr/profile.json",
              "src/locale/fr/reader.json",
              "src/locale/fr/scanlation.json",
              "src/locale/fr/social.json",
              "src/locale/fr/subscription.json",
              "src/locale/fr/upload.json"
            ],
            "subPath": "fr"
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "angular-eslint"
    ]
  }
}
